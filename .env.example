PORT=3000
CEP_PROVIDER_TIMEOUT_MS=5000
VIACEP_BASE_URL=https://viacep.com.br/ws
BRASILAPI_BASE_URL=https://brasilapi.com.br/api/cep/v1
CACHE_TTL_MS=86400000
CACHE_NEGATIVE_TTL_MS=600000

# Circuit Breaker
CB_ERROR_THRESHOLD_PERCENTAGE=50
CB_RESET_TIMEOUT_MS=30000
CB_VOLUME_THRESHOLD=5

# Logging
LOG_LEVEL=info
NODE_ENV=development

# OpenTelemetry
OTEL_SERVICE_NAME=api-cep
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Rate Limiting (Throttler)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

